# Copy this file to ".env" and fill in values only if you want the optional sources.
# .env is git-ignored, so your keys never end up on GitHub.
# .env.example (this file) IS committed — it documents which settings exist, with no real values.

# Optional: Adzuna free developer key (https://developer.adzuna.com) — enables a
# radius search around Lakeland. Leave blank to skip Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: port for the local server (default 5050). We avoid 5000 because macOS
# uses it for AirPlay Receiver. Change this if 5050 is ever "already in use".
JOBFISHER_PORT=5050
